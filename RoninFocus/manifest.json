{
  "manifest_version": 3,
  "name": "RoninFocus",
  "version": "1.2",
  "description": "Cut the Noise. Protect Your Honor. Bloqueador de vídeos curtos.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*", 
        "*://*.instagram.com/*", 
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": ["bloqueador.js"]
    }
  ]
}